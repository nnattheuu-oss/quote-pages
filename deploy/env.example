# Settings for the quote-pages service. Lives at /etc/quote-pages/env on the server (root only).
QP_BASE_URL=https://treejobquote.tech
QP_PORT=7871
QP_DATA=/var/lib/quote-pages
QP_SITE_NAME="Tree Job Quote"
QP_TRIAL_DAYS=14

# The owner's email address: signing in with it opens the owner page.
QP_ADMIN_EMAIL=
# Who a business contacts to pay or get help. Shown on account pages.
QP_SUPPORT_NAME=
QP_SUPPORT_PHONE=

# Sign-in emails, way 1: the server delivers them itself, signed for the domain.
# Make the key and see the DNS records to add with:  python3 app/server.py mailkey
QP_MAIL_FROM="Tree Job Quote <signin@treejobquote.tech>"
QP_DIRECT_MAIL=1
# The server's own name, exactly as the reverse DNS of its IP address gives it
QP_HELO=
# The server's public IPv4 address, for the SPF record
QP_MAIL_IP=
# Where a reply to a sign-in email goes (optional)
QP_REPLY_TO=

# Sign-in emails, way 2: a sending service. If QP_SMTP_HOST is set it is used instead of way 1.
# Run deploy/set-mail.py to fill these in without the password showing on screen.
QP_SMTP_HOST=
QP_SMTP_PORT=465
QP_SMTP_SECURITY=ssl
QP_SMTP_USER=
QP_SMTP_PASS=
