# Settings for the quote-pages service. Lives at /etc/quote-pages/env on the server (root only).
QP_BASE_URL=https://treejobquote.tech
QP_PORT=7871
QP_DATA=/var/lib/quote-pages
QP_SITE_NAME="Tree Job Quote"
QP_TRIAL_DAYS=14

# The owner's email address: signing in with it opens the owner page.
QP_ADMIN_EMAIL=
# Who a business contacts to pay or get help. Shown on account pages.
QP_SUPPORT_NAME=
QP_SUPPORT_PHONE=

# Sign-in emails. Leave QP_SMTP_HOST empty until a sending service is set up.
# Run deploy/set-mail.py to fill these in without the password showing on screen.
QP_SMTP_HOST=
QP_SMTP_PORT=465
QP_SMTP_SECURITY=ssl
QP_SMTP_USER=
QP_SMTP_PASS=
QP_MAIL_FROM="Tree Job Quote <signin@treejobquote.tech>"
